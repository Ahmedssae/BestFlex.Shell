<Window x:Class="BestFlex.Shell.Views.SalesOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sales Order" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Sales Order" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Customer and Order Info -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Customer:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableCustomers}" 
                      SelectedValue="{Binding SelectedCustomerId}" 
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Customer Name:" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomerName}" 
                       VerticalAlignment="Center" Margin="0,10,0,10" Height="30" Background="#F5F5F5" Padding="5"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Credit Available:" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,10">
                <TextBlock Text="{Binding AvailableCredit, StringFormat=C}" FontSize="16" FontWeight="Bold" 
                           Foreground="Green" VerticalAlignment="Center"/>
                <TextBlock Text=" (Limit: " VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBlock Text="{Binding CustomerCreditLimit, StringFormat=C}" VerticalAlignment="Center"/>
                <TextBlock Text=", Current: " VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBlock Text="{Binding CustomerCurrentBalance, StringFormat=C}" VerticalAlignment="Center"/>
                <TextBlock Text=")" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Order Lines -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Add Line" Command="{Binding AddLineCommand}" Width="80" Height="30" Margin="0,0,10,0"/>
                <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding OrderLines}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="200"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Available Stock" Binding="{Binding AvailableStock}" Width="120"/>
                    <DataGridTemplateColumn Header="Actions" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" 
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="60" Height="25"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Order Summary -->
        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,20,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Subtotal, StringFormat=C}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tax:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TaxAmount, StringFormat=C}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Total:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalAmount, StringFormat=C}" FontWeight="Bold" FontSize="16" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0"/>
            </Grid>
        </Border>

        <!-- Validation Errors -->
        <ItemsControl Grid.Row="4" ItemsSource="{Binding ValidationErrors}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Status Message -->
        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="Red" 
                   Margin="0,10,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Width="80" Height="35" Margin="0,0,10,0"/>
            <Button Content="Cancel Order" Command="{Binding CancelOrderCommand}" Width="100" Height="35" Margin="0,0,10,0"/>
            <Button Content="Confirm Order" Command="{Binding ConfirmOrderCommand}" Width="120" Height="35" 
                    Background="Green" Foreground="White"/>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="5" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Height="20" Width="200" Margin="0,0,0,10"/>
                <TextBlock Text="Processing..." Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
