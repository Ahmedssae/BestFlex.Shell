<Window x:Class="BestFlex.Shell.Views.RealDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Real Dashboard" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Real Dashboard" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Width="100" Height="35" Margin="0,0,10,0"/>
                <Button Content="Refresh KPIs" Command="{Binding RefreshKpisCommand}" Width="120" Height="35"/>
            </StackPanel>
        </Grid>

        <!-- KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Today Sales -->
            <Border Grid.Column="0" Background="#E8F5E8" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Today's Sales" FontSize="14" Foreground="#2E7D32"/>
                    <TextBlock Text="{Binding TodaySales, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#2E7D32" Margin="0,5,0,0"/>
                    <TextBlock Text="↑ 12% from yesterday" FontSize="12" Foreground="#4CAF50" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Month Sales -->
            <Border Grid.Column="1" Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="Month Sales" FontSize="14" Foreground="#1565C0"/>
                    <TextBlock Text="{Binding MonthSales, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#1565C0" Margin="0,5,0,0"/>
                    <TextBlock Text="↑ 8% from last month" FontSize="12" Foreground="#2196F3" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Receivables -->
            <Border Grid.Column="2" Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Receivables" FontSize="14" Foreground="#F57C00"/>
                    <TextBlock Text="{Binding TotalReceivables, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#F57C00" Margin="0,5,0,0"/>
                    <TextBlock FontSize="12" Foreground="#FF9800" Margin="0,5,0,0">
                        <Run Text="{Binding PendingInvoices}"/>
                        <Run Text=" pending invoices"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Low Stock Alerts -->
            <Border Grid.Column="3" Background="#FFEBEE" BorderBrush="#F44336" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Low Stock Alerts" FontSize="14" Foreground="#D32F2F"/>
                    <TextBlock Text="{Binding LowStockAlerts}" FontSize="24" FontWeight="Bold" Foreground="#D32F2F" Margin="0,5,0,0"/>
                    <TextBlock Text="Items need restocking" FontSize="12" Foreground="#F44336" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Recent Sales -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Recent Sales" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding RecentSales}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" Width="120"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="200"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding FormattedAmount}" Width="120"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Right Side Panels -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Low Stock Alerts -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Low Stock Alerts" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding LowStockAlertsCollection}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="150"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="80"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="60"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding MinimumStock}" Width="50"/>
                            <DataGridTextColumn Header="Value at Risk" Binding="{Binding FormattedValueAtRisk}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StockStatus}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Top Customers -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Top Customers" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TopCustomers}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="120"/>
                            <DataGridTextColumn Header="Total Sales" Binding="{Binding FormattedTotalSales}" Width="100"/>
                            <DataGridTextColumn Header="Orders" Binding="{Binding OrderCount}" Width="60"/>
                            <DataGridTextColumn Header="Avg Order" Binding="{Binding FormattedAverageOrderValue}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Last Refresh: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LastRefreshTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Total Orders: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalOrders}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBlock Text=" | " VerticalAlignment="Center"/>
                <TextBlock Text="Customers: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalCustomers}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBlock Text=" | " VerticalAlignment="Center"/>
                <TextBlock Text="Products: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalProducts}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Height="20" Width="200" Margin="0,0,0,10"/>
                <TextBlock Text="Loading dashboard data..." Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Error Message -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Red" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   FontSize="14" Margin="0,20,0,0" 
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
    </Grid>
</Window>
