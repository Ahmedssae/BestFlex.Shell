<UserControl x:Class="BestFlex.Shell.Views.SafeFallbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#E74C3C" Padding="20">
            <TextBlock Text="⚠️ Application Error" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Content -->
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="40">
            <TextBlock Text="The application could not load the dashboard."
                       FontSize="16"
                       FontWeight="Medium"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       TextWrapping="Wrap"/>
            
            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="14"
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"
                       TextWrapping="Wrap"/>
            
            <TextBlock Text="Please try again or contact support if the problem persists."
                       FontSize="12"
                       Foreground="#888888"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
        
        <!-- Actions -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="20">
            <Button Content="Retry" 
                    Command="{Binding RetryCommand}"
                    Background="#4CAF50"
                    Foreground="White"
                    Padding="20,10"
                    Margin="10"
                    FontSize="14"
                    FontWeight="Medium"/>
            
            <Button Content="Exit" 
                    Command="{Binding ExitCommand}"
                    Background="#F44336"
                    Foreground="White"
                    Padding="20,10"
                    Margin="10"
                    FontSize="14"
                    FontWeight="Medium"/>
        </StackPanel>
    </Grid>
</UserControl>
