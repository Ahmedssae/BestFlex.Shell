<Window x:Class="BestFlex.Shell.Views.ReceiveStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Receive Stock" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Receive Stock" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Product:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableProducts}" 
                          SelectedValue="{Binding SelectedProductId}" 
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Product Name:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProductName}" 
                           VerticalAlignment="Center" Margin="0,10,0,10" Height="30" Background="#F5F5F5" Padding="5"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Quantity:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Unit Cost:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Reference #:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Notes:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                         Height="60" VerticalContentAlignment="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- Validation Errors -->
            <ItemsControl ItemsSource="{Binding ValidationErrors}" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- New Stock Level Display -->
        <Border Grid.Row="2" Background="#E8F5E8" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="New Stock Level: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding NewStockLevel, StringFormat=N0}" FontSize="18" FontWeight="Bold" 
                           Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status Message -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Red" 
                   Margin="0,10,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Receive Stock" Command="{Binding ReceiveStockCommand}" Width="100" Height="35" Margin="0,0,10,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" Height="35"/>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Height="20" Width="200" Margin="0,0,0,10"/>
                <TextBlock Text="Processing..." Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
