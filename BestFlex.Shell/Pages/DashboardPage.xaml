<UserControl x:Class="BestFlex.Shell.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:BestFlex.Shell.Theme"
             Loaded="UserControl_Loaded">

    <ScrollViewer Background="{StaticResource {x:Static theme:ThemeKeys.BackgroundBrush}}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">
                <TextBlock Text="Dashboard"
                           FontSize="{StaticResource {x:Static theme:ThemeKeys.TitleFontSize}}"
                           Foreground="{StaticResource {x:Static theme:ThemeKeys.TextBrush}}"
                           FontWeight="SemiBold"/>

                <Button DockPanel.Dock="Right"
                        Width="110"
                        Height="28"
                        Style="{StaticResource {x:Static theme:ThemeKeys.ButtonSecondaryStyle}}"
                        Content="{Binding ThemeText}"
                        Click="btnTheme_Click"/>
            </DockPanel>

            <!-- Low Stock -->
            <Border Grid.Row="2"
                    Style="{StaticResource {x:Static theme:ThemeKeys.CardStyle}}">
                <TextBlock Text="Low Stock Alert"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource {x:Static theme:ThemeKeys.TextBrush}}"/>
            </Border>

            <!-- Unpaid Invoices -->
            <Border Grid.Row="4"
                    Style="{StaticResource {x:Static theme:ThemeKeys.CardStyle}}">
                <TextBlock Text="Unpaid Invoices"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource {x:Static theme:ThemeKeys.TextBrush}}"/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
