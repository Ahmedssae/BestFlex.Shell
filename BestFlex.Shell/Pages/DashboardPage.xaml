<UserControl x:Class="BestFlex.Shell.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:BestFlex.Shell.Theme"
             Loaded="UserControl_Loaded">

    <ScrollViewer Background="{StaticResource {x:Static theme:ThemeKeys.BackgroundBrush}}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">
                <TextBlock Text="Dashboard"
                           FontSize="{StaticResource {x:Static theme:ThemeKeys.TitleFontSize}}"
                           Foreground="{StaticResource {x:Static theme:ThemeKeys.TextBrush}}"
                           FontWeight="SemiBold"/>

                <Button DockPanel.Dock="Right"
                        Width="110"
                        Height="28"
                        Style="{StaticResource {x:Static theme:ThemeKeys.ButtonSecondaryStyle}}"
                        Content="{Binding ThemeText}"
                        Click="btnTheme_Click"/>
            </DockPanel>

            <!-- ERP v1.0 Status Banner -->
            <Border Grid.Row="0"
                    Background="{StaticResource {x:Static theme:ThemeKeys.SurfaceBrush}}"
                    Margin="0,0,0,12">
                <StackPanel Margin="12">
                    <TextBlock Text="🎯 BestFlex ERP v1.0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource {x:Static theme:ThemeKeys.TextBrush}}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Production-Ready Features: Login, Users, Customers, Products, Sales Orders, Invoices, Inventory Visibility"
                               FontSize="12"
                               Foreground="Green"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="In Development (v1.1+): Dashboard, Receive Stock, Templates"
                               FontSize="12"
                               Foreground="Orange"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Coming Soon: Reports, Analytics, Advanced Features"
                               FontSize="12"
                               Foreground="Gray"/>
                </StackPanel>
            </Border>

            <!-- Low Stock -->
            <Border Grid.Row="2"
                    Style="{StaticResource {x:Static theme:ThemeKeys.CardStyle}}">
                <StackPanel>
                    <TextBlock Text="📦 Inventory Status"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource {x:Static theme:ThemeKeys.TextBrush}}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Inventory visibility is available in v1.0"
                               FontSize="12"
                               Foreground="Green"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Advanced inventory management coming in v1.1+"
                               FontSize="12"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Unpaid Invoices -->
            <Border Grid.Row="4"
                    Style="{StaticResource {x:Static theme:ThemeKeys.CardStyle}}">
                <StackPanel>
                    <TextBlock Text="💰 Sales &amp; Invoicing"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource {x:Static theme:ThemeKeys.TextBrush}}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="✅ Sales Orders - Create and validate orders"
                               FontSize="12"
                               Foreground="Green"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="✅ Invoices - Post and view invoices"
                               FontSize="12"
                               Foreground="Green"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="❌ Customer Statements - Coming in v1.1+"
                               FontSize="12"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
