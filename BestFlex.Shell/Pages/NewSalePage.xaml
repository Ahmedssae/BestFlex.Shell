<UserControl x:Class="BestFlex.Shell.Pages.NewSalePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Sales Order" FontSize="24" FontWeight="SemiBold" Foreground="#2C3E50"/>
                <TextBlock Text="Create and review customer sales orders" FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                
                <!-- Validation Errors -->
                <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" Padding="12,8" Margin="0,16,0,0" 
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="⚠ Validation Errors" FontSize="12" FontWeight="Medium" Foreground="#E74C3C" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#C0392B" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL - ORDER INFO -->
            <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Order Information" FontSize="16" FontWeight="Medium" Margin="0,0,0,16"/>
                    
                    <!-- Customer Name -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Customer" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,6" BorderBrush="#DDD" BorderThickness="1"/>
                    </StackPanel>
                    
                    <!-- Order Number -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Order Number" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="SO-000000" IsReadOnly="True" Background="#F8F9FA" Height="32" Padding="8,6" BorderBrush="#DDD" BorderThickness="1"/>
                    </StackPanel>
                    
                    <!-- Order Date -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Order Date" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding OrderDate}" Height="32" BorderBrush="#DDD" BorderThickness="1"/>
                    </StackPanel>
                    
                    <!-- Currency -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Currency" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Currency}" Height="32" Padding="8,6" BorderBrush="#DDD" BorderThickness="1"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- MAIN PANEL - ORDER LINES -->
            <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Order Lines" FontSize="16" FontWeight="Medium"/>
                        <Button Grid.Column="1" Content="Add Line" Click="AddLine_Click" Padding="12,6" Background="#3498DB" Foreground="White" BorderThickness="0"/>
                    </Grid>
                    
                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Lines}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderBrush="#DDD"
                              BorderThickness="1"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Width="*" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Quantity" Width="100" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Unit Price" Width="100" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Line Total" Width="100" IsReadOnly="True" Binding="{Binding LineTotal, StringFormat='C'}"/>
                            <DataGridTemplateColumn Header="Actions" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Click="RemoveLine_Click" Padding="8,4" Background="#E74C3C" Foreground="White" BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER - TOTALS & ACTIONS -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Totals -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0" HorizontalAlignment="Right">
                    <StackPanel Orientation="Vertical" Margin="0,0,30,0">
                        <TextBlock Text="Subtotal" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat='C'}" FontSize="16" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical" Margin="0,0,30,0">
                        <TextBlock Text="Tax" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Tax, StringFormat='C'}" FontSize="16" FontWeight="Medium" HorizontalAlignment="Right"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Grand Total" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat='C'}" FontSize="18" FontWeight="SemiBold" Foreground="#2C3E50" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save Draft" IsEnabled="{Binding CanSaveDraft}" Margin="0,0,12,0" 
                            Padding="16,8" Background="#95A5A6" Foreground="White" BorderThickness="0"
                            Click="SaveDraft_Click"/>
                    <Button Content="Post Invoice" IsEnabled="{Binding CanPostOrder}" 
                            Padding="16,8" Background="#E74C3C" Foreground="White" BorderThickness="0"
                            Click="PostInvoice_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
</UserControl>
