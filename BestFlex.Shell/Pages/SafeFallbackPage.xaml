<UserControl x:Class="BestFlex.Shell.Pages.SafeFallbackPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:BestFlex.Shell.Theme">

    <ScrollViewer Background="{StaticResource {x:Static theme:ThemeKeys.BackgroundBrush}}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Error Icon -->
            <Border Grid.Row="0" 
                    Background="{StaticResource {x:Static theme:ThemeKeys.DangerBrush}}"
                    CornerRadius="{StaticResource {x:Static theme:ThemeKeys.BaseRadius}}"
                    Width="48" Height="48" 
                    HorizontalAlignment="Center">
                <TextBlock Text="⚠" 
                           FontSize="24" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Error Title -->
            <TextBlock Grid.Row="2" 
                       Text="Page Load Failed"
                       FontSize="{StaticResource {x:Static theme:ThemeKeys.TitleFontSize}}"
                       FontWeight="Bold"
                       Foreground="{StaticResource {x:Static theme:ThemeKeys.TextBrush}}"
                       HorizontalAlignment="Center"/>

            <!-- Error Message -->
            <TextBlock Grid.Row="4" 
                       Text="{Binding ErrorMessage}"
                       FontSize="{StaticResource {x:Static theme:ThemeKeys.BaseFontSize}}"
                       Foreground="{StaticResource {x:Static theme:ThemeKeys.TextSecondaryBrush}}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <!-- Action Button -->
            <Button Grid.Row="6" 
                    Content="Return to Dashboard"
                    Style="{StaticResource {x:Static theme:ThemeKeys.ButtonSecondaryStyle}}"
                    Width="150"
                    Height="32"
                    Click="ReturnToDashboard_Click"
                    HorizontalAlignment="Center"/>
        </Grid>
    </ScrollViewer>
</UserControl>
