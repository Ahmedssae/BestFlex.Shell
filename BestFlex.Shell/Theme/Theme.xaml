<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:theme="clr-namespace:BestFlex.Shell.Theme">

    <!-- ========================= -->
    <!--   DESIGN TOKENS           -->
    <!-- ========================= -->

    <!-- Palette -->
    <Color x:Key="{x:Static theme:ThemeKeys.PrimaryColor}">#4F46E5</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.PrimaryHoverColor}">#4338CA</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.PrimaryPressedColor}">#3730A3</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.AccentColor}">#10B981</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.DangerColor}">#EF4444</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.SurfaceColor}">#FFFFFFFF</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.BackgroundColor}">#FFF7F7F7</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.BorderColor}">#FFE5E7EB</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.BorderStrongColor}">#FFD1D5DB</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.TextColor}">#FF111827</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.TextSecondaryColor}">#FF4B5563</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.TextMutedColor}">#FF6B7280</Color>
    <Color x:Key="{x:Static theme:ThemeKeys.SelectionColor}">#E6E8F9</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.PrimaryBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.PrimaryColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.PrimaryHoverBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.PrimaryHoverColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.PrimaryPressedBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.PrimaryPressedColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.AccentBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.AccentColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.DangerBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.DangerColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.SurfaceBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.SurfaceColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.BackgroundBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.BackgroundColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.BorderBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.BorderColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.BorderStrongBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.BorderStrongColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.TextBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.TextColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.TextSecondaryBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.TextSecondaryColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.TextMutedBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.TextMutedColor}}"/>
    <SolidColorBrush x:Key="{x:Static theme:ThemeKeys.SelectionBrush}" Color="{StaticResource {x:Static theme:ThemeKeys.SelectionColor}}"/>

    <!-- Metrics -->
    <CornerRadius x:Key="{x:Static theme:ThemeKeys.BaseRadius}">8</CornerRadius>
    <CornerRadius x:Key="{x:Static theme:ThemeKeys.SmallRadius}">6</CornerRadius>
    <sys:Double x:Key="{x:Static theme:ThemeKeys.TitleFontSize}">20</sys:Double>
    <sys:Double x:Key="{x:Static theme:ThemeKeys.H2FontSize}">16</sys:Double>
    <sys:Double x:Key="{x:Static theme:ThemeKeys.BaseFontSize}">13</sys:Double>
    <FontFamily x:Key="{x:Static theme:ThemeKeys.MainFont}">Segoe UI</FontFamily>
    <Thickness x:Key="{x:Static theme:ThemeKeys.ControlPadding}">10,6</Thickness>
    <Thickness x:Key="{x:Static theme:ThemeKeys.CardPadding}">12</Thickness>

    <!-- ========================= -->
    <!--   SURFACE / CARD          -->
    <!-- ========================= -->

    <Style TargetType="Grid" x:Key="{x:Static theme:ThemeKeys.AppSurfaceStyle}">
        <Setter Property="Background" Value="{StaticResource {x:Static theme:ThemeKeys.BackgroundBrush}}"/>
    </Style>

    <Style x:Key="{x:Static theme:ThemeKeys.CardStyle}" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource {x:Static theme:ThemeKeys.BaseRadius}}"/>
        <Setter Property="Background" Value="{StaticResource {x:Static theme:ThemeKeys.SurfaceBrush}}"/>
        <Setter Property="BorderBrush" Value="{StaticResource {x:Static theme:ThemeKeys.BorderBrush}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource {x:Static theme:ThemeKeys.CardPadding}}"/>
    </Style>

    <!-- ========================= -->
    <!--   BUTTONS                 -->
    <!-- ========================= -->

    <Style x:Key="{x:Static theme:ThemeKeys.ButtonBaseStyle}" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource {x:Static theme:ThemeKeys.MainFont}}"/>
        <Setter Property="FontSize" Value="{StaticResource {x:Static theme:ThemeKeys.BaseFontSize}}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource {x:Static theme:ThemeKeys.PrimaryBrush}}"/>
        <Setter Property="BorderBrush" Value="{StaticResource {x:Static theme:ThemeKeys.PrimaryBrush}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root"
                  CornerRadius="{StaticResource {x:Static theme:ThemeKeys.SmallRadius}}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="4,2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource {x:Static theme:ThemeKeys.PrimaryHoverBrush}}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource {x:Static theme:ThemeKeys.PrimaryHoverBrush}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource {x:Static theme:ThemeKeys.PrimaryPressedBrush}}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource {x:Static theme:ThemeKeys.PrimaryPressedBrush}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static theme:ThemeKeys.ButtonSecondaryStyle}" TargetType="Button" BasedOn="{StaticResource {x:Static theme:ThemeKeys.ButtonBaseStyle}}">
        <Setter Property="Foreground" Value="{StaticResource {x:Static theme:ThemeKeys.TextBrush}}"/>
        <Setter Property="Background" Value="#FFF3F4F6"/>
        <Setter Property="BorderBrush" Value="{StaticResource {x:Static theme:ThemeKeys.BorderStrongBrush}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="root"
                  CornerRadius="{StaticResource {x:Static theme:ThemeKeys.SmallRadius}}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="4,2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="#FFEFF1F5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Background" Value="#FFE5E7EB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static theme:ThemeKeys.ButtonDangerStyle}" TargetType="Button" BasedOn="{StaticResource {x:Static theme:ThemeKeys.ButtonBaseStyle}}">
        <Setter Property="Background" Value="{StaticResource {x:Static theme:ThemeKeys.DangerBrush}}"/>
        <Setter Property="BorderBrush" Value="{StaticResource {x:Static theme:ThemeKeys.DangerBrush}}"/>
    </Style>

</ResourceDictionary>
