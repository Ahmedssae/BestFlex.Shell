<Window x:Class="BestFlex.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BestFlex.Shell.Controls"
        Title="BestFlex — Main Menu" Height="500" Width="980"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
  

    <DockPanel>

        <!-- === Top Menu === -->
        <Menu DockPanel.Dock="Top" Background="#2f343d" Foreground="White">
            <MenuItem Header="_Account">
                <MenuItem Header="Change _Password" Command="{Binding ChangePasswordCommand}"/>
                <Separator/>
                <MenuItem Header="_Sign Out" Command="{Binding SignOutCommand}"/>
                <MenuItem Header="_Settings" Width="120" Command="{Binding OpenSettingsCommand}" IsEnabled="{Binding CanManageSettings}"/>
            </MenuItem>
        </Menu>

        <!-- === Layout: Sidebar + Main Host === -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Sidebar" Margin="8"/>
                </ScrollViewer>
            </Border>

            <!-- Spacer -->
            <Rectangle Grid.Column="1" Fill="Transparent"/>

            <!-- Main content HOST (navigation area) -->
            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <ContentControl x:Name="MainHost"/>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Global Busy Overlay -->
        <controls:BusyOverlay x:Name="GlobalBusyOverlay" 
                              IsBusy="{Binding IsBusy}" 
                              Message="{Binding BusyMessage}" 
                              Detail="{Binding BusyDetail}"/>
    </DockPanel>
</Window>
