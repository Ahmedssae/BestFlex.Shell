<UserControl x:Class="BestFlex.Shell.Controls.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#80000000"
             Visibility="Collapsed">
    <Grid>
        <Border Background="White" 
                CornerRadius="8" 
                Padding="30" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                MinWidth="300"
                MaxWidth="400">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding Message}" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"
                           TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True" 
                             Height="6" 
                             Margin="0,0,0,10"
                             Background="#E0E0E0"
                             Foreground="#007ACC"/>
                <TextBlock Text="{Binding Detail}" 
                           FontSize="12" 
                           Foreground="#666666" 
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
